{
  "name": "@feng0531/dsh-code-review",
  "version": "0.95.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./child": "./src/review-child-plugin.mjs",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "scripts/review-bench-adapter.mjs",
    "evaluation/REVIEWBENCH-LOCAL.md",
    "index.mjs",
    "dist/client.js",
    "cordis.patch.yml",
    "src/",
    "locale/",
    "README.md",
    "CHANGELOG.md",
    "RELEASE-NOTES.md",
    "DEVELOPMENT.md",
    "CORE-ALIGNMENT-TASKS.md",
    "CORE-SOURCE-INVENTORY.md",
    "SVN-SUPPORT-MATRIX.md",
    "SVN-RELEASE-EVIDENCE.md",
    "LICENSE",
    "LICENSES/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/f-e-n-g-0531/dsh-code-review.git"
  },
  "type": "module",
  "description": "Read-only Git/SVN code review for DSH",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
